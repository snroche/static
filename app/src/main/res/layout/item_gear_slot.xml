<?xml version="1.0" encoding="utf-8"?>
<!-- One gear slot on a person's page: an outlined box with the slot's icon, its name and
     what's in it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:layout_weight="1"
    android:background="@drawable/bg_tile_home"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="88dp"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/slotIcon"
        style="@style/TerminalText.Bright"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/slotName"
        style="@style/TerminalText.Dim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/slotPiece"
        style="@style/TerminalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:textSize="13sp" />
</LinearLayout>
