<?xml version="1.0" encoding="utf-8"?>
<!-- One log line, with a day separator above it when the day changes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/day"
        style="@style/TerminalText.Dim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:textColor="@color/amber_hint"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Between two expeditions in EXPEDITIONS → ALL. -->
    <View
        android:id="@+id/threadDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="4dp"
        android:background="@color/amber_hint"
        android:visibility="gone" />

    <TextView
        android:id="@+id/text"
        style="@style/TerminalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="2dp"
        android:textIsSelectable="false" />
</LinearLayout>
