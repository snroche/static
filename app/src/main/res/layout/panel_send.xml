<?xml version="1.0" encoding="utf-8"?>
<!-- Send out, in two steps you can switch between freely: who goes (crew tiles, long-press
     for the leader) and where (place blocks, sortable). Then send. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/terminal_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    tools:ignore="Overdraw">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TerminalHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/send_title"
            tools:targetApi="28" />

        <TextView
            android:id="@+id/sendClose"
            style="@style/TerminalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="@string/panel_back" />
    </LinearLayout>

    <!-- The two steps. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/sendStepWho"
            style="@style/TerminalSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2" />

        <TextView
            android:id="@+id/sendStepWhere"
            style="@style/TerminalSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2" />
    </LinearLayout>

    <!-- Sorting the places (WHERE only); remembered. -->
    <LinearLayout
        android:id="@+id/sendSortBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <TextView
            style="@style/TerminalText.Dim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="@string/send_sort"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/sortDanger"
            style="@style/TerminalSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="36dp"
            android:text="@string/send_sort_danger" />

        <TextView
            android:id="@+id/sortPicked"
            style="@style/TerminalSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="36dp"
            android:text="@string/send_sort_picked" />

        <TextView
            android:id="@+id/sortTime"
            style="@style/TerminalSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="36dp"
            android:text="@string/send_sort_time" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sendList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        android:paddingBottom="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/amber_hint" />

    <TextView
        android:id="@+id/sendSummary"
        style="@style/TerminalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp" />

    <TextView
        android:id="@+id/sendGo"
        style="@style/TerminalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:text="@string/send_go" />
</LinearLayout>
