<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/name"
        style="@style/TerminalText.Bright"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/status"
        style="@style/TerminalText.Dim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/stats"
        style="@style/TerminalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/vitals"
        style="@style/TerminalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/bond"
        style="@style/TerminalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/task"
        style="@style/TerminalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/traits"
        style="@style/TerminalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/likes"
        style="@style/TerminalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/dislikes"
        style="@style/TerminalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/gear"
        style="@style/TerminalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/gifts"
        style="@style/TerminalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/bio"
        style="@style/TerminalText.Dim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="13sp" />

    <!-- Actions wrap onto a second line on narrow screens. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/dispatch"
            style="@style/TerminalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dispatch_button" />

        <TextView
            android:id="@+id/talk"
            style="@style/TerminalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/talk_button" />

        <TextView
            android:id="@+id/gift"
            style="@style/TerminalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gift_button" />

        <TextView
            android:id="@+id/taskButton"
            style="@style/TerminalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/task_button" />

        <TextView
            android:id="@+id/equipButton"
            style="@style/TerminalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/equip_button" />

        <androidx.constraintlayout.helper.widget.Flow
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="dispatch,talk,gift,taskButton,equipButton"
            app:flow_horizontalBias="0"
            app:flow_horizontalGap="4dp"
            app:flow_horizontalStyle="packed"
            app:flow_wrapMode="chain"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
