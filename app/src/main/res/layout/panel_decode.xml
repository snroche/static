<?xml version="1.0" encoding="utf-8"?>
<!-- Decoder (GDD §6.2): Caesar shift dial or Morse tap pad. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/terminal_bg"
    android:clickable="true"
    tools:ignore="Overdraw"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            style="@style/TerminalHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            tools:targetApi="28" />

        <TextView
            android:id="@+id/back"
            style="@style/TerminalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="@string/panel_back" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/instructions"
                style="@style/TerminalText.Dim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/cipher"
                style="@style/TerminalText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textIsSelectable="true" />

            <TextView
                android:id="@+id/answer"
                style="@style/TerminalText.Bright"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:minLines="2" />

            <!-- Caesar -->
            <LinearLayout
                android:id="@+id/caesarControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/shiftDown"
                    style="@style/TerminalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/shift_down_description"
                    android:text="@string/shift_down" />

                <TextView
                    android:id="@+id/shift"
                    style="@style/TerminalText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/shiftUp"
                    style="@style/TerminalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/shift_up_description"
                    android:text="@string/shift_up" />
            </LinearLayout>

            <!-- Morse -->
            <LinearLayout
                android:id="@+id/morseControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dot"
                        style="@style/TerminalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:contentDescription="@string/dot_description"
                        android:gravity="center"
                        android:text="@string/morse_dot" />

                    <TextView
                        android:id="@+id/dash"
                        style="@style/TerminalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:contentDescription="@string/dash_description"
                        android:gravity="center"
                        android:text="@string/morse_dash" />

                    <TextView
                        android:id="@+id/erase"
                        style="@style/TerminalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:contentDescription="@string/erase_description"
                        android:gravity="center"
                        android:text="@string/morse_erase" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/letter"
                        style="@style/TerminalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/morse_letter" />

                    <TextView
                        android:id="@+id/space"
                        style="@style/TerminalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/morse_space" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tableButton"
                    style="@style/TerminalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/morse_table" />

                <TextView
                    android:id="@+id/table"
                    style="@style/TerminalText.Dim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/send"
                style="@style/TerminalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/send_button" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
