<?xml version="1.0" encoding="utf-8"?>
<!-- Confirmation before wiping every save and setting. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="@style/TerminalHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        tools:targetApi="28"
        android:background="@color/danger"
        android:text="@string/reset_title" />

    <TextView
        style="@style/TerminalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/reset_body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:baselineAligned="false"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/resetCancel"
            style="@style/TerminalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset_cancel" />

        <TextView
            android:id="@+id/resetConfirm"
            style="@style/TerminalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/reset_confirm"
            android:textColor="@color/danger" />
    </LinearLayout>
</LinearLayout>
