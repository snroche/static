<?xml version="1.0" encoding="utf-8"?>
<!-- Crew tile, out on a mission: a dashed frame in the radio's color. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/amber_hint">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/terminal_bg" />
            <stroke
                android:width="2dp"
                android:color="@color/signal"
                android:dashGap="4dp"
                android:dashWidth="8dp" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</ripple>
