<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform theme on purpose: no AppCompat/Material dependency for a text-only UI. -->
    <style name="Theme.Estatica" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/terminal_bg</item>
        <item name="android:statusBarColor">@color/terminal_bg</item>
        <item name="android:navigationBarColor">@color/terminal_bg</item>
        <item name="android:colorAccent">@color/amber</item>
        <item name="android:colorControlActivated">@color/amber</item>
        <item name="android:textColorHighlight">@color/amber_dim</item>
        <item name="android:textColorPrimary">@color/amber</item>
    </style>

    <style name="TerminalText">
        <item name="android:fontFamily">@font/terminal</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/amber</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <!-- Subtle CRT phosphor glow (GDD §2). Static: drawn once per text change. -->
        <item name="android:shadowColor">@color/amber_glow</item>
        <item name="android:shadowRadius">6</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
    </style>

    <style name="TerminalText.Dim">
        <item name="android:textColor">@color/amber_dim</item>
    </style>

    <style name="TerminalText.Bright">
        <item name="android:textColor">@color/amber_bright</item>
    </style>

    <!-- Top bar: three buttons must fit at 360dp. -->
    <style name="TerminalButton.Top">
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <!-- Panel title: inverse video, like a terminal's title bar. -->
    <style name="TerminalHeader" parent="TerminalText.Bright">
        <item name="android:background">@color/amber</item>
        <item name="android:textColor">@color/terminal_bg</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:shadowRadius">0</item>
    </style>

    <!-- Bottom bar tab: centered, 48dp touch target; the selected one is bright. -->
    <style name="TerminalTab" parent="TerminalText.Dim">
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <!-- Section button (radio, bunker): one line, shrinks to fit, brackets drawn when selected. -->
    <style name="TerminalSection" parent="TerminalText.Bright">
        <item name="android:background">@drawable/bg_terminal_button</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">8sp</item>
        <item name="android:autoSizeMaxTextSize">13sp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Section button with an icon over its label (radio): two lines, like the bottom bar. -->
    <style name="TerminalSection.Icon">
        <item name="android:maxLines">2</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:autoSizeMaxTextSize">12sp</item>
    </style>

    <!-- Text button: [ LABEL ], 48dp touch target. -->
    <style name="TerminalButton" parent="TerminalText.Bright">
        <item name="android:background">@drawable/bg_terminal_button</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
